{
    // ══════════════════════════════════════════════════════════════════════
    // 通用大厅图：游戏大厅 → 各活动模块的专属入口页
    // 这一份是所有模块共用的。新模块要接入，只需要在这里加自己的入口链，
    // 不需要写任何 Python 寻路代码。
    //
    // 写法约定（照抄即可）：
    //   1. 节点名 = 「模块名_要去做什么」；终点确认节点名以「已到达」开头。
    //   2. roi 一律用归一化坐标 [x1,y1,x2,y2]（0~1），换分辨率/换窗口不用改。
    //   3. 点击目标 = 识别框中心，代码里没有绝对坐标。
    //   4. fallback_pct 是"按钮小图还没截"时的过渡兜底，补上模板图就自动失效。
    //   5. 终点节点 action=DoNothing 且不写 next —— 图到此结束。
    //   6. 每个模块链最后必须挂一个「已到达X页」确认节点，跑图方按它判成败。
    //   7. 节点里的模板名按"跑图方登记的模板目录"解析：各模块只给自己走的链供图，
    //      别人家的节点不进自己的图就不需要那张图。
    // ══════════════════════════════════════════════════════════════════════

    // ── 极速狂飙：大厅卡片 → 活动页 ────────────────────────────────────
    // 注意：鉴宝的入口跳转不在这里。它仍由 plugins/treasure 自己的阶段意图路径
    // （module.py 的「游戏大厅 → 点巅峰鉴宝卡片」）驱动，且将在 NavKit S3 阶段
    // 由 assets.json 生成。原先手抄在此处的鉴宝链已于 2026-09-05 删除：
    // 它的 roi 与 treasure_rois.json 不一致（0.55,0.55 vs 0.760,0.803），
    // 且从未被任何代码引用，是双真源的反例教材。
    "极速狂飙_从大厅进入": {
        "recognition": "Custom",
        "custom_recognition": "MRA_Template",
        "custom_recognition_param": {
            "templates": ["racing_activity_card"],
            "threshold": 0.72,
            "roi": [0.55, 0.55, 1.00, 0.90],
            "fallback_pct": [0.880, 0.720]
        },
        "action": "Custom",
        "custom_action": "MRA_Click",
        "custom_action_param": { "timeout_s": 25, "wait_after_ms": 1200 },
        "rate_limit": 600,
        "timeout": 45000,
        "next": ["已到达极速狂飙页"]
    },
    "已到达极速狂飙页": {
        "recognition": "Custom",
        "custom_recognition": "MRA_Template",
        "custom_recognition_param": {
            "templates": ["activity_page_template"],
            "threshold": 0.55
        },
        "action": "DoNothing",
        "rate_limit": 500,
        "timeout": 20000
    }
}
