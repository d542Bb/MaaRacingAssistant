# 归档（被 sidecar + WinUI3 取代的旧 GUI、历史 spike）
archive/

# WinUI 3 / .NET 构建产物（apps/mra_shell）
apps/mra_shell/bin/
apps/mra_shell/obj/

# 发布打包产物（体积大，不入库；本地 staging/zip/sha256 放这里）
build/release/
# 探索/验证用临时运行时（spike 的完整 python runtime 数百 MB，不入库）
build/spike/

# 本地复用缓存（已验证 runtime 依赖 + 已编译 GUI，跳过重复下载/编译）
build/runtime-cache/
build/publish-cache/

# PoC / 本地打包测试产物（native Launcher 编译输出、临时测试布局、组装测试目录）
build/poc/
build/poc-app/
build/PoC */
build/assemble-test/
build/zip-e2e/

# assemble.ps1 本地打包产物（默认输出到 scripts/release；CI 输出到 build/release 已忽略）
scripts/release/MaaRacingAssistant-*/
scripts/release/MaaRacingAssistant-*.zip
scripts/release/MaaRacingAssistant-*.zip.sha256

# 系统
Thumbs.db
.DS_Store

# 本机启动快捷方式（指向机器相关构建产物路径，仅本地使用，不同步）
